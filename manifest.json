{
  "manifest_version": 3,
  "name": "Tab Merger",
  "version": "1.0.0",
  "description": "Move the tabs of every window into the current one.",
  "permissions": ["tabGroups"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Merge all windows into this one",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      }
    }
  }
}
